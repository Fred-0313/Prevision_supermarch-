    "    elif mois in [3,4,5]:\n",
    "        return \"Pre_Rainy\"\n",
    "    elif mois in [6,7,8,9]:\n",
    "        return \"Rainy\"\n",
    "    else:\n",
    "        return \"Post_Rainy\"\n",
    "df[\"season\"] = df[\"month\"].apply(saison)\n"
